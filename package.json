{
  "name": "feather-tree",
  "version": "0.1.0",
  "private": true,
  "description": "軽量な Windows 向け git GUI クライアント",
  "author": "FeatherTree",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamodengaku/feather-tree.git"
  },
  "homepage": "https://github.com/hamodengaku/feather-tree",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/clean.mjs out && electron-vite dev",
    "build": "node scripts/clean.mjs out && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:deps": "depcruise packages --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run icon && npm run build && node scripts/dist.mjs",
    "measure": "node scripts/measure.mjs",
    "verify": "npm run lint:deps && npm run typecheck && npm run test",
    "check:svelte": "svelte-check --tsconfig packages/renderer/tsconfig.json",
    "postinstall": "node scripts/postinstall.mjs",
    "test:perf": "node scripts/test-perf.mjs",
    "icon": "node scripts/make-icon.mjs",
    "clean": "node scripts/clean.mjs out release",
    "demo:repo": "node scripts/make-demo-repo.mjs",
    "dist:dir": "npm run icon && npm run build && node scripts/dist.mjs --dir",
    "test:unity-perf": "node scripts/test-unity-perf.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "26.5.0",
    "dependency-cruiser": "18.2.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "^17.12.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
